#############################
# Source of truth .gitignore #
#############################

# Dependencies
node_modules/

# Build output
dist/
build/
dist-ssr/
web-build/

# Test coverage (MO2-8: generise `jest --coverage`, ne ide u repo)
coverage/

# Logs
logs/
*.log
npm-debug.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local env files (do not commit secrets)
.env
.env.*
!.env.example
# `backend/.env` je uprkos gornjem pravilu bio U GITU — bio je dodat prije nego
# je pravilo postojalo, a git ignoriše samo nove fajlove. Zato eksplicitno:
backend/.env
frontend/.env
mobile/.env

# Expo (local state)
.expo/

# Metro / RN temp files
.metro-health-check*

# OS / Editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.local
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Repo-specific
*.txt
*.apk
apps/mobile/*.apk
/backend/src/generated
