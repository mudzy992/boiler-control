{
  "name": "boiler-control-tv",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --platform android --clean",
    "build:tv": "EXPO_TV=1 eas build --platform android --profile production",
    "test": "jest --forceExit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-tvos/config-tv": "^0.1.7",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "buffer": "^6.0.3",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "^58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.87.1-1",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "~15.14.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|react-native-tvos|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@react-native-tvos/.*|react-native-svg|react-native-qrcode-svg))"
    ]
  }
}
