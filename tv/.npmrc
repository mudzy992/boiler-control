# `react-native-tvos` objavljuje verzije sa sufiksom (`0.87.1-1`), a paketi sa
# peer zahtjevom `react-native@">=0.63.4"` ga ne zadovoljavaju jer npm tretira
# `-1` kao prerelease. To je poznato za TV fork, ne greška našeg izbora
# verzija: Expo SDK 58 mapira na RN-TV `0.87-stable`, tj. upravo ovu verziju.
legacy-peer-deps=true
