generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  transpile    = "true"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                Int                      @id @default(autoincrement())
  email                                             String                   @unique
  passwordHash                                      String
  name                                              String?
  createdAt                                         DateTime                 @default(now())
  updatedAt                                         DateTime                 @updatedAt
  homeLocation                                      String?
  avatarUrl                                         String?
  isActive                                          Boolean                  @default(true)
  lastLoginAt                                       DateTime?
  locale                                            String?
  plan                                              UserPlan                 @default(FREE)
  prefersDarkMode                                   Boolean?
  role                                              UserRole                 @default(USER)
  timezone                                          String?
  activeHomeProfileId                               Int?                     @unique
  gasPriceExVat                                     Float?
  username                                          String?                  @unique
  currentBoilerFlowTemp                             Float?
  currentBoilerFlowTempSetAt                        DateTime?
  boilerHistories                                   BoilerHistory[]
  GasPriceHistory                                   GasPriceHistory[]
  gasReadings                                       GasReading[]
  homeProfiles                                      HomeProfile[]
  notifications                                     Notification[]
  notificationPreferences                           NotificationPreference[]
  recommendations                                   Recommendation[]
  thermostatDevices                                 ThermostatDevice[]
  HomeProfile_User_activeHomeProfileIdToHomeProfile HomeProfile?             @relation("User_activeHomeProfileIdToHomeProfile", fields: [activeHomeProfileId], references: [id])
  devices                                           UserDevice[]
  refreshTokens                                     RefreshToken[]
  dailyRecords                                      DailyRecord[]
}

model HomeProfile {
  id                                         Int                        @id @default(autoincrement())
  userId                                     Int
  floorArea                                  Float
  ceilingHeight                              Float
  insulationType                             HomeProfile_insulationType
  insulationThickness                        Float
  windowType                                 HomeProfile_windowType
  constructionYear                           Int
  createdAt                                  DateTime                   @default(now())
  updatedAt                                  DateTime                   @updatedAt
  learningConfidence                         Float                      @default(0)
  learningOffset                             Float                      @default(0)
  heatingType                                HomeProfile_heatingType
  seasonMode                                 SeasonMode                 @default(WINTER)
  /// Zastarjelo: slobodan tekst koji je zamijenio katalog (`19` §1). Ostaje
  /// samo kao istorijski podatak — **nijedna odluka se na njega ne oslanja**.
  boilerModel                                String?
  /// Zapis iz kataloga (`backend/src/modules/BoilerCatalog/catalog.json`).
  /// Iz njega se zna jesu li grijanje i PTV odvojeni — i smije li se polazna
  /// uopšte savjetovati snižavati. `null` = model nije odabran.
  boilerCatalogId                            String?
  /// Najviša polazna koju **sistem** dozvoljava: kotao ili podno grijanje
  /// (`19` §2, odluka vlasnika 2026-11-08). `null` = nije poznata, pa se
  /// koristi granica kotla (55). Nikad ne širi raspon 30–55, samo sužava.
  maxHeatingFlowC                            Float?
  hasFloorHeating                            Boolean                    @default(false)
  homeName                                   String?
  numberOfResidents                          Int?
  preferredScheduleNotes                     String?
  targetDayTemp                              Float?
  targetMorningTemp                          Float?
  targetNightTemp                            Float?
  location                                   String?
  weatherLatitude                            Float?
  weatherLongitude                           Float?
  weatherTimezone                            String?
  weatherLocationProvider                    String?
  weatherLocationProviderId                  String?
  weatherLocationLabel                       String?
  weatherLocationName                        String?
  weatherLocationAdmin1                      String?
  weatherLocationCountry                     String?
  weatherLocationCountryCode                 String?
  weatherLocationConfirmedAt                 DateTime?
  intervalLearnings                          HeatingIntervalLearning[]
  user                                       User                       @relation(fields: [userId], references: [id])
  thermostatDevices                          ThermostatDevice[]
  User_User_activeHomeProfileIdToHomeProfile User?                      @relation("User_activeHomeProfileIdToHomeProfile")
  dailyRecords                               DailyRecord[]
  homeModel                                  HomeModel?

  @@index([userId])
}

model ThermostatDevice {
  id                Int                 @id @default(autoincrement())
  alias             String?
  lastSeen          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  homeProfileId     Int
  mode              ThermostatMode      @default(MANUAL)
  deviceId          String
  userId            Int
  vendor            String
  roomCurrentTemp   Float?
  roomTargetTemp    Float?
  lastSnapshotAt    DateTime?
  heatingEvents     HeatingEvent[]
  observations      ThermostatObservation[]
  homeProfile       HomeProfile         @relation(fields: [homeProfileId], references: [id])
  user              User                @relation(fields: [userId], references: [id])
  thermostatProgram ThermostatProgram[]

  @@index([homeProfileId])
  @@index([userId])
}

model ThermostatProgram {
  id          Int              @id @default(autoincrement())
  deviceId    Int
  dayType     DayType
  startMinute Int
  targetTemp  Float
  orderIndex  Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  programHash String?
  device      ThermostatDevice @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, dayType, orderIndex])
}

model HeatingEvent {
  id               Int              @id @default(autoincrement())
  roomCurrentTemp  Float            @map("currentTemp")
  roomTargetTemp   Float            @map("targetTemp")
  source           String
  createdAt        DateTime         @default(now())
  deviceId         Int
  hvacAction       String
  timestampEnd     DateTime?
  timestampStart   DateTime
  isAnomaly        Boolean          @default(false)
  proposedEndTime  DateTime?
  userConfimed     Boolean          @default(false)
  anomalyCheckedAt DateTime?
  thermostat       ThermostatDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
  @@index([deviceId, timestampStart(sort: Desc)])
}

model Recommendation {
  id                  Int      @id @default(autoincrement())
  userId              Int
  recommendedFlowTemp Float
  expectedHeatTimeMin Float
  confidenceScore     Float
  breakdown           Json?
  createdAt           DateTime @default(now())
  date                DateTime
  user                User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model WeatherCache {
  id                Int      @id @default(autoincrement())
  city              String
  fetchedAt         DateTime @default(now())
  humidity          Float?
  cloud             Int?
  condition_text    String?
  feelslike         Float?
  gust_kph          Float?
  moon_illumination Int?
  moon_phase        String?
  moonrise          String?
  moonset           String?
  precipitation_mm  Float?
  pressure_mb       Float?
  snow_cm           Float?
  sunrise           String?
  sunset            String?
  temp_avg          Float?
  temp_max          Float?
  temp_min          Float?
  temperature       Float
  uv_index          Float?
  wind_dir          String?
  wind_kph          Float?
}

model WeatherV2Cache {
  id        Int      @id @default(autoincrement())
  cacheKey  String   @unique
  provider  String
  payload   Json
  fetchedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fetchedAt])
}

model BoilerHistory {
  id                Int       @id @default(autoincrement())
  userId            Int
  externalTemp      Float
  suggestedFlowTemp Float     @map("suggestedTemp")
  actualFlowTemp    Float?    @map("actualTemp")
  heatingStart      DateTime?
  heatingEnd        DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model GasReading {
  id                     Int       @id @default(autoincrement())
  userId                 Int
  readingDate            DateTime
  counterValue           Float
  consumption            Float?
  createdAt              DateTime  @default(now())
  invoiceGasPriceExVat   Float?
  invoicePdfMime         String?
  invoicePdfOriginalName String?
  invoicePdfPath         String?
  invoiceUploadedAt      DateTime?
  isInvoiceReference     Boolean   @default(false)
  meterImageMime         String?
  meterImageOriginalName String?
  meterImagePath         String?
  referenceMonth         DateTime?
  user                   User      @relation(fields: [userId], references: [id])

  @@unique([userId, referenceMonth])
}

enum InsulationType {
  STANDARD
  EPS
  MINERAL_WOOL
  ADVANCED
}

enum WindowType {
  SINGLE_GLAZED
  DOUBLE_GLAZED
  TRIPLE_GLAZED
}

enum HeatingType {
  RADIATOR
  UNDERFLOOR
  MIXED
}

model HeatingIntervalLearning {
  id              Int         @id @default(autoincrement())
  homeProfileId   Int
  intervalKey     String
  avgReachTimeMin Float
  avgOvershoot    Float
  offset          Float       @default(0)
  confidence      Float       @default(0)
  samples         Int         @default(0)
  lastUpdated     DateTime    @default(now())
  homeProfile     HomeProfile @relation(fields: [homeProfileId], references: [id])

  @@unique([homeProfileId, intervalKey])
}

model TuyaToken {
  id          Int      @id @default(autoincrement())
  accessToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserDevice {
  id            Int       @id @default(autoincrement())
  userId        Int
  platform      String
  expoPushToken String    @unique
  isActive      Boolean   @default(true)
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Notification {
  id         Int              @id @default(autoincrement())
  userId     Int
  type       NotificationType
  title      String
  message    String
  data       Json?
  sentAt     DateTime         @default(now())
  deliveryOk Boolean          @default(true)
  sourceRef  String?
  createdAt  DateTime         @default(now())
  isRead     Boolean          @default(false)
  user       User             @relation(fields: [userId], references: [id])

  @@unique([userId, sourceRef])
  @@index([userId])
  @@index([type])
}

model NotificationPreference {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])

  @@unique([userId, type])
}

model GasPriceHistory {
  id            Int       @id @default(autoincrement())
  userId        Int
  priceExVat    Float
  vatRate       Float     @default(0.17)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  source        String
  gasReadingId  Int?
  createdAt     DateTime  @default(now())
  User          User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum SeasonMode {
  WINTER
  SUMMER
  AUTO
}

/// Odakle je polazna temperatura na snazi u 06:00 (`17` §5.2, `18` §0).
/// `CARRIED` znači da vrijednost nije unesena danas nego važi od ranije,
/// `UNKNOWN` da aplikacija u tom trenutku nije imala nikakav unos.
enum FlowSetSource {
  USER
  CARRIED
  UNKNOWN
}

/// Odakle je zabilježeno stanje (`17` §5.1). `TUYA` je očitanje adaptera,
/// `MANUAL` ručni unos; nova vrijednost se dodaje, postojeća ne mijenja.
enum ObservationSource {
  TUYA
  MANUAL
}

/// Stanje modela kuće (`17` §5.3). `COLD_START` = premalo dana, `TRACKING` =
/// procjena prihvaćena, `DEGRADED` = nema dovoljno ulaza ili je procjena
/// odbijena. U `DEGRADED` predlog se NE mijenja (`17` §11).
enum HomeModelState {
  COLD_START
  TRACKING
  DEGRADED
}

/// Jedan red po kući: ono što je izmjereno, sa dokazom kako je izmjereno
/// (`17` §6).
///
/// `slopeS` je jedina veličina koja se danas može identificirati iz podataka:
/// odnos `b/a` iz dnevnog bilansa energije. Apsolutni `a` i `b` traže prozore
/// mirovanja/grijanja ≥ 45 min, kojih u kućama sa kratkim ciklusima nema
/// (mjereno u `17` §6.2), pa ostaju `null` dok ih sekundarna metoda ne nađe.
model HomeModel {
  id            Int @id @default(autoincrement())
  homeProfileId Int @unique

  /// `s = b/a` — nagib krive kuće.
  slopeS     Float?
  slopeCiLow Float?
  slopeCiHigh Float?
  /// `c = q_int/k1` — dnevni član unutrašnjih dobitaka. Nije fizička konstanta.
  internalGainC Float?

  aPerHour Float?
  bPerHour Float?

  /// Dani u fitu i dani koji su uopšte razmatrani (razlika je filtrirao).
  days          Int @default(0)
  daysEvaluated Int @default(0)
  residualStd   Float?

  /// Koji uređaj je dao seriju. Kuća sa dva termostata u dvije sobe nije jedan
  /// model; do tada fit koristi ISKLJUČIVO primarni uređaj (`21` §7).
  sourceDeviceId Int?

  /// `u_day` — dnevni član za sunce/goste/kuhanje (`17` §13 korak 7).
  /// Pozitivno = više dobitaka tog perioda, pa polazna ide **niže**.
  /// `null` znači „nema procjene" (manje od 4 dana), ne „nula".
  uDayC    Float?
  /// Koliko dana je ušlo u medijanu koja je dala `uDayC`.
  uDayDays Int?
  uDayAt   DateTime?

  /// Najniža polazna pri kojoj su izmjereni kratki ciklusi (`24` §4). Kao i
  /// noćni minimum, to je granica ispod koje se ne ide — i pamti se, jer bi se
  /// inače polazna vraćala na istu grešku svaki drugi dan.
  shortCycleFloorC  Float?
  shortCycleFloorAt DateTime?

  state  HomeModelState @default(COLD_START)
  /// Zašto je stanje takvo. Prazno znači "nema šta da se objasni".
  reason String?

  modelVersion String
  windowDays   Int
  /// Kada je fit posljednji put POKUŠAN (svaki prolaz).
  lastAttemptAt DateTime?
  /// Kada su brojevi posljednji put ZAPISANI (samo uspješan fit). U `DEGRADED`
  /// se brojevi ne diraju, pa `lastFitAt` pokazuje koliko je stara procjena.
  lastFitAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeProfile HomeProfile @relation(fields: [homeProfileId], references: [id], onDelete: Cascade)
}

/// Vremenska serija (`17` §5.1). Jedan red po uređaju i petominutnom bucketu.
///
/// `at` je POČETAK bucketa, ne trenutak upisa: tako dva očitanja iz istog
/// bucketa (npr. ponovni ciklus poslije restarta) ne mogu oba ući, a serija
/// ostaje poravnata na pet minuta bez obzira na to kad je upis stvarno pao.
///
/// Nijedno polje se ne izmišlja: ako uređaj nije poslao temperaturu, polje je
/// `null`. Nula bi bila izmjeren podatak koji nije izmjeren.
model ThermostatObservation {
  id            Int      @id @default(autoincrement())
  deviceId      Int
  /// Denormalizovano iz uređaja: učenje radi po kući, a ne po uređaju.
  homeProfileId Int
  at            DateTime

  roomTempC    Float?
  targetTempC  Float?
  isHeating    Boolean
  outdoorTempC Float?
  flowSetC     Float?

  source    ObservationSource @default(TUYA)
  createdAt DateTime          @default(now())

  device ThermostatDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, at])
  @@index([homeProfileId, at])
}

/// Jedan red po kući i lokalnom danu (`17` §5.2). Piše ga ISKLJUČIVO
/// `DailyRecordWriter`, jednom, i poslije se ne prepisuje — zato je
/// `proposedAt` historija, a ne "zadnje viđeno".
///
/// Red postoji i kada predloga nema (`proposedFlowTemp = null`, `skipReason`
/// objašnjava zašto). Tako se "procijenili smo i namjerno nismo predložili"
/// razlikuje od "sistem nije radio", gdje reda uopšte nema.
model DailyRecord {
  id            Int    @id @default(autoincrement())
  userId        Int
  homeProfileId Int
  /// `YYYY-MM-DD` u zoni kuće. Tekst, ne DATE: DATE bi se kroz UTC pomjerio.
  localDate     String @db.VarChar(10)

  proposedFlowTemp Float?
  proposedAt       DateTime?
  seasonMode       SeasonMode?
  skipReason       String?

  flowSetC               Float?
  flowSetSince           DateTime?
  flowSetSource          FlowSetSource?
  flowSetChangedDuringDay Boolean      @default(false)

  nightMinC   Float?
  dayMeanC    Float?
  dayMaxC     Float?
  degreeHours Float?

  modelVersion String?
  slopeS       Float?
  slopeCi      Float?
  params       Json?

  cycles         Int?
  medianCycleMin Float?
  dutyPercent    Float?
  overshootC     Float?
  comfortOk      Boolean?
  undershootC    Float?
  /// Najveći manjak u noćnom prozoru (22:00 prethodnog dana → 06:00 ovog).
  /// Odvojeno od dnevnog `undershootC` jer noć je ono što predlog mora pokriti.
  nightUndershootC Float?
  /// Najhladniji izmjereni sat te noći. Nije isto što i `nightMinC` (prognoza
  /// koja je bila osnov predloga) — ovo je ono što se stvarno dogodilo.
  nightMinOutdoorMeasuredC Float?
  /// Polazna koja je te noći stvarno bila na kotlu. Sa `nightMinOutdoorMeasuredC`
  /// i `nightUndershootC` čini dokaz „ova polazna nije bila dovoljna".
  nightFlowC Float?
  /// Izmjereno iz serije (`17` §9.4): `median(T_off − T_on)` i
  /// `median(cilj − T_on)`. `null` dok nema ≥ 2 prelaza u danu.
  hysteresisK          Float?
  hysteresisAsymmetryK Float?
  /// Kada su mjerni podaci upisani. `null` = dan još nije obračunat.
  outcomeAt      DateTime?
  outcomeVersion String?

  // --- shadow odluka kontrolera (`24`) -------------------------------------
  // Računa se uz predlog, ali **ne mijenja** `proposedFlowTemp`. Služi da se
  // uporedi sa onim što je korisnik dobio, prije nego odluka postane predlog.
  /// Šta bi kontroler predložio. `null` = nije računato ili nije imao osnova.
  shadowFlowC    Float?
  shadowAction   String?
  /// Razlozi odluke, spojeni `+` (npr. `UNDERSHOOT+NIGHT_FLOOR`).
  shadowReasons  String?
  shadowAt       DateTime?
  shadowVersion  String?

  /// Da li je shadow odluka tog dana bila **istraživanje**, a ne konvergencija
  /// (`17` §8.5). Ime nosi `shadow` jer odluka još ne dira bojler: kolona
  /// `exploration` koja opisuje nešto što se nije dogodilo bila bi lažan zapis.
  shadowExploration          Boolean @default(false)
  shadowExplorationDirection String?

  gasM3      Float?
  degreeDays Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeProfile HomeProfile @relation(fields: [homeProfileId], references: [id], onDelete: Cascade)

  @@unique([homeProfileId, localDate])
  @@index([userId, localDate])
}

enum NotificationType {
  DAILY_RECOMMENDATION
  FLOW_TEMP_CHANGED
  HEATING_STARTED
  HEATING_ENDED
  SYSTEM_ALERT
  GAS_READING_REMINDER
}

enum ThermostatMode {
  MANUAL
  PROGRAM
  OFF
}

enum DayType {
  WORKDAY
  SATURDAY
  SUNDAY
}

enum UserRole {
  USER
  ADMIN
  SUPPORT
}

enum UserPlan {
  FREE
  PRO
  ENTERPRISE
}

enum HomeProfile_insulationType {
  STANDARD
  EPS
  MINERAL_WOOL
  ADVANCED
}

enum HomeProfile_windowType {
  SINGLE_GLAZED
  DOUBLE_GLAZED
  TRIPLE_GLAZED
}

enum HomeProfile_heatingType {
  RADIATOR
  UNDERFLOOR
  MIXED
}

/// SEC-4: rotirani refresh token. Čuva se ISKLJUČIVO SHA-256 hash vrijednosti,
/// nikad sam token. `revokedAt` omogućava opoziv; ponovno korištenje već
/// opozvanog tokena tretira se kao krađa i opoziva sve sesije korisnika.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
