// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  name          String?
  homeLocation String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  homeProfiles      HomeProfile[]
  thermostatDevices ThermostatDevice[]
  recommendations   Recommendation[]
  boilerHistories   BoilerHistory[]
}

model HomeProfile {
  id                  Int                       @id @default(autoincrement())
  user                User                      @relation(fields: [userId], references: [id])
  userId              Int
  floorArea           Float
  ceilingHeight       Float
  insulationType      String
  insulationThickness Float
  windowType          String
  heatingType         String
  constructionYear    Int
  learningOffset      Float                     @default(0) // ± korekcija krivulje
  learningConfidence  Float                     @default(0) // 0–1
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  thermostatDevices   ThermostatDevice[]
  intervalLearnings   HeatingIntervalLearning[]
}

model ThermostatDevice {
  id            Int            @id @default(autoincrement())
  user          User           @relation(fields: [userId], references: [id])
  userId        Int
  homeProfile   HomeProfile    @relation(fields: [homeProfileId], references: [id])
  homeProfileId Int
  vendor        String
  deviceId      String
  alias         String?
  lastSeen      DateTime?
  mode          ThermostatMode @default(MANUAL) // MANUAL ili PROGRAM
  heatingEvents HeatingEvent[]
  thermostatProgram ThermostatProgram[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ThermostatProgram {
  id             Int      @id @default(autoincrement())
  deviceId       Int
  dayType        DayType  // WORKDAY | SATURDAY | SUNDAY
  startMinute    Int      // npr 6:30 = 390
  targetTemp     Float
  orderIndex     Int      // 0..5 (radi lakšeg sortiranja)
  programHash    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  device ThermostatDevice @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, dayType, orderIndex])
}

model HeatingEvent {
  id             Int              @id @default(autoincrement())
  thermostat     ThermostatDevice @relation(fields: [deviceId], references: [id])
  deviceId       Int
  timestampStart DateTime
  timestampEnd   DateTime?
  currentTemp    Float
  targetTemp     Float
  hvacAction     String
  source         String

  createdAt DateTime @default(now())
}

model Recommendation {
  id                  Int      @id @default(autoincrement())
  user                User     @relation(fields: [userId], references: [id])
  userId              Int
  date                DateTime
  recommendedFlowTemp Float
  expectedHeatTimeMin Float
  confidenceScore     Float

  createdAt DateTime @default(now())
}

model WeatherCache {
  id                Int      @id @default(autoincrement())
  city              String
  temperature       Float // trenutna temperatura
  feelslike         Float? // kako se osjeća
  temp_min          Float? // minimalna današnja temperatura
  temp_max          Float? // maksimalna današnja temperatura
  temp_avg          Float? // prosječna dnevna temperatura
  wind_kph          Float? // brzina vjetra
  gust_kph          Float? // udari vjetra
  wind_dir          String? // smjer vjetra
  pressure_mb       Float? // atmosferski pritisak
  humidity          Float? // vlaga
  cloud             Int? // oblačnost (%)
  uv_index          Float? // UV indeks
  precipitation_mm  Float? // ukupna padavina
  snow_cm           Float? // snijeg u cm
  condition_text    String? // tekstualni opis (sunce, kiša, snijeg...)
  sunrise           String? // vrijeme izlaska sunca
  sunset            String? // vrijeme zalaska sunca
  moonrise          String?
  moonset           String?
  moon_phase        String?
  moon_illumination Int?
  fetchedAt         DateTime @default(now())
}

model BoilerHistory {
  id            Int       @id @default(autoincrement())
  user          User      @relation(fields: [userId], references: [id])
  userId        Int
  externalTemp  Float
  suggestedTemp Float
  actualTemp    Float?
  heatingStart  DateTime?
  heatingEnd    DateTime?
  createdAt     DateTime  @default(now())
}

model HeatingIntervalLearning {
  id              Int         @id @default(autoincrement())
  homeProfileId   Int
  intervalKey     String // npr. "weekday_morning_1"
  avgReachTimeMin Float
  avgOvershoot    Float
  offset          Float       @default(0) // ± korekcija kotla
  confidence      Float       @default(0) // 0–1
  samples         Int         @default(0)
  lastUpdated     DateTime    @default(now())
  homeProfile     HomeProfile @relation(fields: [homeProfileId], references: [id])

  @@unique([homeProfileId, intervalKey])
}

model TuyaToken {
  id          Int      @id @default(autoincrement())
  accessToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ThermostatMode {
  MANUAL
  PROGRAM
  OFF
}

enum DayType {
  WORKDAY
  SATURDAY
  SUNDAY
}
