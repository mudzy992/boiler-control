{
  "expo": {
    "name": "Boiler Control",
    "slug": "boiler-control",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/new/boiler-control-icon-master.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/new/splash_branding.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/new/ic_notification.png",
      "color": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.boilercontrol.app"
    },
    "android": {
      "package": "com.boilercontrol.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/new/ic_launcher_foreground.png",
        "backgroundImage": "./assets/new/ic_launcher_background.png",
        "monochromeImage": "./assets/new/ic_launcher_monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://boiler-control.hopto.org/backend/api"
    }
  }
}
