model HomeProfile {
  id                  Int                       @id @default(autoincrement())
  user                User                      @relation(fields: [userId], references: [id])
  userId              Int
  floorArea           Float                                 // Grejni prostor 150m2
  ceilingHeight       Float                                 // Visina plafona 230 cm
  insulationType      String                                // Vrsta izolacije EPS Wool
  insulationThickness Float                                 // Debljina izolacije 10, 12, 15 cm
  windowType          String                                // Tip stolarije double/ triple PVC, Wood
  heatingType         String                                // Tip grijanja radijator, podno
  constructionYear    Int                                   // Godina izgradnje objekta
  learningOffset      Float                     @default(0) // ± korekcija krivulje
  learningConfidence  Float                     @default(0) // 0–1
  seasonMode          SeasonMode                @default(WINTER) // Ljetni/Zimski režim
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  thermostatDevices   ThermostatDevice[]
  intervalLearnings   HeatingIntervalLearning[]
}

model ThermostatDevice {
  id            Int            @id @default(autoincrement())
  user          User           @relation(fields: [userId], references: [id])
  userId        Int
  homeProfile   HomeProfile    @relation(fields: [homeProfileId], references: [id])
  homeProfileId Int
  vendor        String
  deviceId      String
  alias         String?
  lastSeen      DateTime?
  roomTargetTemp     Float?
  roomCurrentTemp    Float?
  mode          ThermostatMode @default(MANUAL) // MANUAL ili PROGRAM
  heatingEvents HeatingEvent[]
  thermostatProgram ThermostatProgram[]
  lastSnapshotAt  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ThermostatProgram {
  id             Int      @id @default(autoincrement())
  deviceId       Int
  dayType        DayType  // WORKDAY | SATURDAY | SUNDAY
  startMinute    Int      // npr 6:30 = 390
  targetTemp     Float    // 22,5
  orderIndex     Int      // 0..5 (radi lakšeg sortiranja)
  programHash    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  device ThermostatDevice @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, dayType, orderIndex])
}

model HeatingEvent {
  id             Int              @id @default(autoincrement())
  thermostat     ThermostatDevice @relation(fields: [deviceId], references: [id])
  deviceId       Int
  timestampStart DateTime                          // Početak grijanja
  timestampEnd   DateTime?                         // Završetak grijanja
  roomCurrentTemp    Float           @map("currentTemp")                  // Trenutna temperatura u prostoriji
  roomTargetTemp     Float           @map("targetTemp")                   // Temperatura koja treba da se dostigne
  hvacAction     String                            // Informacija da li je grijanje u toku ili ne
  source         String
  isAnomaly      Boolean         @default(false)   // Uočena anomalija (cron postavlja na true)
  proposedEndTime DateTime?                        // Cron prijedlog za Završetak
  userConfimed    Boolean        @default(false)   // Potvrda korisnika

  createdAt DateTime @default(now())
}

model Recommendation {
  id                  Int      @id @default(autoincrement())
  user                User     @relation(fields: [userId], references: [id])
  userId              Int
  date                DateTime
  recommendedFlowTemp Float                               // Predložena temperatura vode kotla
  expectedHeatTimeMin Float                               // Očekivano vrijeme zagrijavanja
  confidenceScore     Float                               //

  createdAt DateTime @default(now())
}

model WeatherCache {
  id                Int      @id @default(autoincrement())
  city              String
  temperature       Float // trenutna temperatura
  feelslike         Float? // kako se osjeća
  temp_min          Float? // minimalna današnja temperatura
  temp_max          Float? // maksimalna današnja temperatura
  temp_avg          Float? // prosječna dnevna temperatura
  wind_kph          Float? // brzina vjetra
  gust_kph          Float? // udari vjetra
  wind_dir          String? // smjer vjetra
  pressure_mb       Float? // atmosferski pritisak
  humidity          Float? // vlaga
  cloud             Int? // oblačnost (%)
  uv_index          Float? // UV indeks
  precipitation_mm  Float? // ukupna padavina
  snow_cm           Float? // snijeg u cm
  condition_text    String? // tekstualni opis (sunce, kiša, snijeg...)
  sunrise           String? // vrijeme izlaska sunca
  sunset            String? // vrijeme zalaska sunca
  moonrise          String?
  moonset           String?
  moon_phase        String?
  moon_illumination Int?
  fetchedAt         DateTime @default(now())
}

model BoilerHistory {
  id            Int       @id @default(autoincrement())
  user          User      @relation(fields: [userId], references: [id])
  userId        Int
  externalTemp  Float                                // Trenutna vanjska temperatura
  suggestedFlowTemp Float         @map("suggestedTemp")                       // Predložena temperatura vode kotla (polazna voda)
  actualFlowTemp    Float?        @map("actualTemp")                          // Trenutna aktuelna temperatura vode kotla (polazna voda)
  heatingStart  DateTime?                            // Početak grijanja
  heatingEnd    DateTime?                            // Kraj grijanja
  createdAt     DateTime  @default(now())
}

model GasReading {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id])
  userId       Int
  readingDate  DateTime
  counterValue Float    // Stanje brojila (m3)
  consumption  Float?   // Potrošnja od zadnjeg očitavanja (m3)

  createdAt    DateTime @default(now())
}

enum SeasonMode {
  WINTER
  SUMMER
  AUTO
}

model HeatingIntervalLearning {
  id              Int         @id @default(autoincrement())
  homeProfileId   Int
  intervalKey     String // npr. "weekday_morning_1"
  avgReachTimeMin Float
  avgOvershoot    Float
  offset          Float       @default(0) // ± korekcija kotla
  confidence      Float       @default(0) // 0–1
  samples         Int         @default(0)
  lastUpdated     DateTime    @default(now())
  homeProfile     HomeProfile @relation(fields: [homeProfileId], references: [id])

  @@unique([homeProfileId, intervalKey])
}

model TuyaToken {
  id          Int      @id @default(autoincrement())
  accessToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserDevice {
  id              Int      @id @default(autoincrement())
  user             User     @relation(fields: [userId], references: [id])
  userId           Int

  platform         String   // ios | android
  expoPushToken    String   @unique
  isActive         Boolean  @default(true)

  lastSeenAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id])
  userId       Int

  type         NotificationType
  title        String
  message      String

  data         Json?        // payload (flowTemp, eventId, etc.)
  sentAt       DateTime     @default(now())
  deliveryOk   Boolean      @default(true)

  sourceRef    String?      // npr. "daily_recommendation_2026-01-16"

  createdAt    DateTime     @default(now())

  @@index([userId])
  @@index([type])
  @@unique([userId, sourceRef])
}

model NotificationPreference {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  type      NotificationType
  enabled   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
}

enum NotificationType {
  DAILY_RECOMMENDATION
  FLOW_TEMP_CHANGED
  HEATING_STARTED
  HEATING_ENDED
  SYSTEM_ALERT
}

enum ThermostatMode {
  MANUAL
  PROGRAM
  OFF
}

enum DayType {
  WORKDAY
  SATURDAY
  SUNDAY
}

enum UserRole {
  USER
  ADMIN
  SUPPORT
}

enum UserPlan {
  FREE
  PRO
  ENTERPRISE
}
