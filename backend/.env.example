# =====================================================================
# SANITIZED FILE — see docs/MYSQL_TO_POSTGRES_MIGRATION.md
#
# The real production credentials that used to live in this file were
# removed as part of the MySQL -> PostgreSQL migration prep, because
# this file should never have contained live secrets in the first
# place (see CRITICAL finding in the project audit). Fill in real
# values locally / in your secret manager; never commit real values
# here. This file is already covered by .gitignore (`.env.*`).
# =====================================================================

APP_PORT=3020

# Postgres connection (replace with real values, do not commit)
DATABASE_URL="postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/boiler_assistant"
DATABASE_USER="CHANGE_ME_USER"
DATABASE_PASSWORD="CHANGE_ME_PASSWORD"
DATABASE_NAME="boiler_assistant"
DATABASE_HOST="CHANGE_ME_HOST"
DATABASE_PORT=5432
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=5000

JWT_SECRET="CHANGE_ME_ROTATE_THIS_SECRET"
JWT_EXPIRES_IN="3600s"

# PRIV-1A: samo self-service JSON export naloga. Zadano off; nema brisanja.
ACCOUNT_EXPORT_ENABLED=off
ACCOUNT_EXPORT_MAX_ROWS_PER_COLLECTION=1000
ACCOUNT_EXPORT_MAX_BYTES=5242880

# SEC-6: dedicated metrics scraper token. Minimum 32 chars, no whitespace.
# Generate locally, e.g. `openssl rand -hex 32`; never commit the real value.
# Missing/weak token makes /metrics* return 503 (fail-closed).
METRICS_AUTH_TOKEN=""

WEATHER_API_KEY="CHANGE_ME_ROTATE_THIS_KEY"

# FEAT-1 / REL-1 / MO2-17: weather v2. Rollout flagovi su zadano off.
WEATHER_LOCATION_V2=off
WEATHER_RECOMMENDATION_V2=off
WEATHER_BOILER_V2=off
WEATHER_SWR_ENABLED=off
WEATHER_STALE_AFTER_MINUTES=15
WEATHER_CURRENT_HIDDEN_AFTER_MINUTES=60

TUYA_CLIENT_ID="CHANGE_ME_ROTATE_THIS_ID"
TUYA_CLIENT_SECRET="CHANGE_ME_ROTATE_THIS_SECRET"
TUYA_REGION=EU
TUYA_BASE_URL=https://openapi.tuyaeu.com

NODE_ENV=production # ako je development onda cron neće raditi
TZ=Europe/Sarajevo

# FEAT-6: analytics export v2 (JSON + eksplicitna IANA zona). Default off.
# Legacy /api/dashboard/export bez version=2 ostaje nepromijenjen.
ANALYTICS_EXPORT_V2_ENABLED=off
# Maksimalan broj source redova (heating events + learning intervals) po v2 izvozu.
# Dozvoljeno 1..50000; neispravna vrijednost koristi default 10000.
ANALYTICS_EXPORT_MAX_ROWS=10000

# PERF-2: bounded thermostat polling. Default on; rollback postavi off.
POLL_PAGINATION_ENABLED=on
# Velicina keyset batch-a za listing uredjaja. Dozvoljeno 1..500;
# neispravna vrijednost koristi default 100.
POLL_BATCH_SIZE=100
