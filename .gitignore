#############################
# Source of truth .gitignore #
#############################

# Dependencies
node_modules/

# Build output
dist/
build/
dist-ssr/
web-build/

# Logs
logs/
*.log
npm-debug.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local env files (do not commit secrets)
*.apk
.env
.env.*
!.env.example

# Expo (local state)
.expo/

# Metro / RN temp files
.metro-health-check*

# OS / Editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.local
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Repo-specific
*.txt
*.apk
/backend/src/generated
