generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  transpile    = "true"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                Int                      @id @default(autoincrement())
  email                                             String                   @unique
  passwordHash                                      String
  name                                              String?
  createdAt                                         DateTime                 @default(now())
  updatedAt                                         DateTime                 @updatedAt
  homeLocation                                      String?
  avatarUrl                                         String?
  isActive                                          Boolean                  @default(true)
  lastLoginAt                                       DateTime?
  locale                                            String?
  plan                                              UserPlan                 @default(FREE)
  prefersDarkMode                                   Boolean?
  role                                              UserRole                 @default(USER)
  timezone                                          String?
  activeHomeProfileId                               Int?                     @unique
  gasPriceExVat                                     Float?
  username                                          String?                  @unique
  currentBoilerFlowTemp                             Float?
  currentBoilerFlowTempSetAt                        DateTime?
  boilerHistories                                   BoilerHistory[]
  GasPriceHistory                                   GasPriceHistory[]
  gasReadings                                       GasReading[]
  homeProfiles                                      HomeProfile[]
  notifications                                     Notification[]
  notificationPreferences                           NotificationPreference[]
  recommendations                                   Recommendation[]
  thermostatDevices                                 ThermostatDevice[]
  HomeProfile_User_activeHomeProfileIdToHomeProfile HomeProfile?             @relation("User_activeHomeProfileIdToHomeProfile", fields: [activeHomeProfileId], references: [id])
  devices                                           UserDevice[]
  refreshTokens                                     RefreshToken[]
}

model HomeProfile {
  id                                         Int                        @id @default(autoincrement())
  userId                                     Int
  floorArea                                  Float
  ceilingHeight                              Float
  insulationType                             HomeProfile_insulationType
  insulationThickness                        Float
  windowType                                 HomeProfile_windowType
  constructionYear                           Int
  createdAt                                  DateTime                   @default(now())
  updatedAt                                  DateTime                   @updatedAt
  learningConfidence                         Float                      @default(0)
  learningOffset                             Float                      @default(0)
  heatingType                                HomeProfile_heatingType
  seasonMode                                 SeasonMode                 @default(WINTER)
  boilerModel                                String?
  hasFloorHeating                            Boolean                    @default(false)
  homeName                                   String?
  numberOfResidents                          Int?
  preferredScheduleNotes                     String?
  targetDayTemp                              Float?
  targetMorningTemp                          Float?
  targetNightTemp                            Float?
  location                                   String?
  intervalLearnings                          HeatingIntervalLearning[]
  user                                       User                       @relation(fields: [userId], references: [id])
  thermostatDevices                          ThermostatDevice[]
  User_User_activeHomeProfileIdToHomeProfile User?                      @relation("User_activeHomeProfileIdToHomeProfile")

  @@index([userId])
}

model ThermostatDevice {
  id                Int                 @id @default(autoincrement())
  alias             String?
  lastSeen          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  homeProfileId     Int
  mode              ThermostatMode      @default(MANUAL)
  deviceId          String
  userId            Int
  vendor            String
  roomCurrentTemp   Float?
  roomTargetTemp    Float?
  lastSnapshotAt    DateTime?
  heatingEvents     HeatingEvent[]
  homeProfile       HomeProfile         @relation(fields: [homeProfileId], references: [id])
  user              User                @relation(fields: [userId], references: [id])
  thermostatProgram ThermostatProgram[]

  @@index([homeProfileId])
  @@index([userId])
}

model ThermostatProgram {
  id          Int              @id @default(autoincrement())
  deviceId    Int
  dayType     DayType
  startMinute Int
  targetTemp  Float
  orderIndex  Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  programHash String?
  device      ThermostatDevice @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, dayType, orderIndex])
}

model HeatingEvent {
  id               Int              @id @default(autoincrement())
  roomCurrentTemp  Float            @map("currentTemp")
  roomTargetTemp   Float            @map("targetTemp")
  source           String
  createdAt        DateTime         @default(now())
  deviceId         Int
  hvacAction       String
  timestampEnd     DateTime?
  timestampStart   DateTime
  isAnomaly        Boolean          @default(false)
  proposedEndTime  DateTime?
  userConfimed     Boolean          @default(false)
  anomalyCheckedAt DateTime?
  thermostat       ThermostatDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
}

model Recommendation {
  id                  Int      @id @default(autoincrement())
  userId              Int
  recommendedFlowTemp Float
  expectedHeatTimeMin Float
  confidenceScore     Float
  createdAt           DateTime @default(now())
  date                DateTime
  user                User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model WeatherCache {
  id                Int      @id @default(autoincrement())
  city              String
  fetchedAt         DateTime @default(now())
  humidity          Float?
  cloud             Int?
  condition_text    String?
  feelslike         Float?
  gust_kph          Float?
  moon_illumination Int?
  moon_phase        String?
  moonrise          String?
  moonset           String?
  precipitation_mm  Float?
  pressure_mb       Float?
  snow_cm           Float?
  sunrise           String?
  sunset            String?
  temp_avg          Float?
  temp_max          Float?
  temp_min          Float?
  temperature       Float
  uv_index          Float?
  wind_dir          String?
  wind_kph          Float?
}

model BoilerHistory {
  id                Int       @id @default(autoincrement())
  userId            Int
  externalTemp      Float
  suggestedFlowTemp Float     @map("suggestedTemp")
  actualFlowTemp    Float?    @map("actualTemp")
  heatingStart      DateTime?
  heatingEnd        DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model GasReading {
  id                     Int       @id @default(autoincrement())
  userId                 Int
  readingDate            DateTime
  counterValue           Float
  consumption            Float?
  createdAt              DateTime  @default(now())
  invoiceGasPriceExVat   Float?
  invoicePdfMime         String?
  invoicePdfOriginalName String?
  invoicePdfPath         String?
  invoiceUploadedAt      DateTime?
  isInvoiceReference     Boolean   @default(false)
  meterImageMime         String?
  meterImageOriginalName String?
  meterImagePath         String?
  referenceMonth         DateTime?
  user                   User      @relation(fields: [userId], references: [id])

  @@unique([userId, referenceMonth])
}

enum InsulationType {
  STANDARD
  EPS
  MINERAL_WOOL
  ADVANCED
}

enum WindowType {
  SINGLE_GLAZED
  DOUBLE_GLAZED
  TRIPLE_GLAZED
}

enum HeatingType {
  RADIATOR
  UNDERFLOOR
  MIXED
}

model HeatingIntervalLearning {
  id              Int         @id @default(autoincrement())
  homeProfileId   Int
  intervalKey     String
  avgReachTimeMin Float
  avgOvershoot    Float
  offset          Float       @default(0)
  confidence      Float       @default(0)
  samples         Int         @default(0)
  lastUpdated     DateTime    @default(now())
  homeProfile     HomeProfile @relation(fields: [homeProfileId], references: [id])

  @@unique([homeProfileId, intervalKey])
}

model TuyaToken {
  id          Int      @id @default(autoincrement())
  accessToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserDevice {
  id            Int       @id @default(autoincrement())
  userId        Int
  platform      String
  expoPushToken String    @unique
  isActive      Boolean   @default(true)
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Notification {
  id         Int              @id @default(autoincrement())
  userId     Int
  type       NotificationType
  title      String
  message    String
  data       Json?
  sentAt     DateTime         @default(now())
  deliveryOk Boolean          @default(true)
  sourceRef  String?
  createdAt  DateTime         @default(now())
  isRead     Boolean          @default(false)
  user       User             @relation(fields: [userId], references: [id])

  @@unique([userId, sourceRef])
  @@index([userId])
  @@index([type])
}

model NotificationPreference {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])

  @@unique([userId, type])
}

model GasPriceHistory {
  id            Int       @id @default(autoincrement())
  userId        Int
  priceExVat    Float
  vatRate       Float     @default(0.17)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  source        String
  gasReadingId  Int?
  createdAt     DateTime  @default(now())
  User          User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum SeasonMode {
  WINTER
  SUMMER
  AUTO
}

enum NotificationType {
  DAILY_RECOMMENDATION
  FLOW_TEMP_CHANGED
  HEATING_STARTED
  HEATING_ENDED
  SYSTEM_ALERT
  GAS_READING_REMINDER
}

enum ThermostatMode {
  MANUAL
  PROGRAM
  OFF
}

enum DayType {
  WORKDAY
  SATURDAY
  SUNDAY
}

enum UserRole {
  USER
  ADMIN
  SUPPORT
}

enum UserPlan {
  FREE
  PRO
  ENTERPRISE
}

enum HomeProfile_insulationType {
  STANDARD
  EPS
  MINERAL_WOOL
  ADVANCED
}

enum HomeProfile_windowType {
  SINGLE_GLAZED
  DOUBLE_GLAZED
  TRIPLE_GLAZED
}

enum HomeProfile_heatingType {
  RADIATOR
  UNDERFLOOR
  MIXED
}

/// SEC-4: rotirani refresh token. Čuva se ISKLJUČIVO SHA-256 hash vrijednosti,
/// nikad sam token. `revokedAt` omogućava opoziv; ponovno korištenje već
/// opozvanog tokena tretira se kao krađa i opoziva sve sesije korisnika.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
