#############################
# Source of truth .gitignore #
#############################

# Dependencies
node_modules/

# Build output
dist/
# `scripts/build/build-menu.sh` upisuje ovdje staru verziju da bi je vratio ako
# build padne. Ne commitovati: sadrži stanje lokalne mašine, ne izvorni kod.
.build-restore
# `build/` je gradle/Expo izlaz — ali NE i `scripts/build/`, gdje živi
# lokalna build skripta. Goli `build/` uzorak bi tiho izbacio skriptu iz repoa
# (izmjereno: `git check-ignore` je hvatao `scripts/build/build-menu.sh`).
build/
!scripts/build/

# `expo prebuild` izlaz — generise se iz `app.config.js` i NE ide u repo.
#
# Dva razloga, oba izmjerena 17.11.:
# 1. `prebuild` generise `release { signingConfig signingConfigs.debug }` — tj.
#    lokalni release APK je potpisan DEBUG kljucem. EAS build potpisuje svojim.
#    Dvije razlicite potpise za isti `applicationId` Androida vide kao
#    „App not installed as package conflicts with an existing package".
# 2. Generisani folder nosi `versionCode` iz trenutka generisanja; commitovan bi
#    drzao staru verziju i tiha izmjena u `app.config.js` ne bi vazila.
mobile/android/
tv/android/

# Tajne za potpisivanje lokalnog release builda. Nikad u repo:
# `keystore.properties` sadrži lozinku, a `.jks` je privatni ključ.
# Šablon (`android/keystore.properties.example`) se generiše `prebuild`-om
# iz `scripts/build/android-signing.js` — v. docs/BUILD-LOKALNO.md.
keystore.properties
*.jks
*.keystore
!debug.keystore
mobile/ios/
tv/ios/
dist-ssr/
web-build/

# Test coverage (MO2-8: generise `jest --coverage`, ne ide u repo)
coverage/

# Logs
logs/
*.log
npm-debug.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local env files (do not commit secrets)
.env
.env.*
!.env.example
# `backend/.env` je uprkos gornjem pravilu bio U GITU — bio je dodat prije nego
# je pravilo postojalo, a git ignoriše samo nove fajlove. Zato eksplicitno:
backend/.env
frontend/.env
mobile/.env

# Expo (local state)
.expo/

# Metro / RN temp files
.metro-health-check*

# OS / Editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.local
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Repo-specific
*.txt
*.apk
apps/mobile/*.apk
/backend/src/generated
